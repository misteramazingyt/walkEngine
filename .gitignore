# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
dev.db
dev.db-journal

# prisma generated client
/src/generated/

# Connections corpus: third-party transcripts, video, and derived scene data.
# Analysed locally to induce narrative rules; never redistributed. The
# findings written from it are committed, the material itself is not.
/tools/connections-corpus/corpus/
/tools/connections-corpus/**/__pycache__/
