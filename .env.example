# MOTIF WALK environment. Copy to .env and edit:
#
#   cp .env.example .env
#
# Every variable here has a working default except GEMINI_API_KEY, so an
# empty .env is enough for random and criteriological walks against live
# Wikipedia. Burke, Anamnetic, and BurkeCluster modes need either the key or
# fixture mode — without one of the two they fail loudly rather than invent.

# SQLite file, relative to the repository root. `npm run setup` creates it.
DATABASE_URL="file:./dev.db"

# Gemini credentials for the LLM-driven walk modes (Phase 3.5).
# Key: https://aistudio.google.com/apikey — leave blank to stay offline.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# fixture = deterministic demonstration graph (touchstone → … → radar)
# instead of live Wikipedia/Wikidata. Offline, no HTTP, no rate limits.
# WIKIPEDIA_MODE="fixture"

# fixture = deterministic oracles instead of Gemini, so the Burke,
# Anamnetic, and BurkeCluster modes run with no API key. Implied by
# WIKIPEDIA_MODE=fixture. Both are set for you by `npm run dev:fixture`.
# LLM_MODE="fixture"
